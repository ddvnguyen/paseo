# Slim EAS upload: docs only. NEVER exclude packages/*, scripts/, or
# patches/ — the monorepo install (postinstall-patches.mjs) and the
# eas-build-post-install hook (build:app-deps) need them on the builder.
.github/
.dev/
*.md
.gitignore
.easignore

# EAS cloud runner has bun 1.2 which can't read lockfileVersion 2 (bun 1.4+).
# Exclude bun.lock so EAS falls back to npm with package-lock.json.
bun.lock
bun.lockb
