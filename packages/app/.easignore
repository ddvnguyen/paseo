# Exclude non-app packages and docs from EAS upload.
# NOTE: protocol/plugin/highlight/expo-two-way-audio must stay included —
# eas-build-post-install's build:app-deps step builds them from source
# (npm run build --workspace=@getpaseo/<pkg>), which fails with "No
# workspaces found" if the workspace directory isn't in the upload.
packages/cli/
packages/desktop/
packages/relay/
packages/website/
docs/
.github/
.dev/
*.md
.gitignore
.easignore

# EAS cloud runner has bun 1.2 which can't read lockfileVersion 2 (bun 1.4+).
# Exclude bun.lock so EAS falls back to npm with package-lock.json.
bun.lock
bun.lockb
