{
  "name": "@getpaseo/freebuff-acp",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Client Protocol (ACP) adapter for Freebuff, backed by @codebuff/sdk",
  "bin": {
    "freebuff-acp": "./dist/entry.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./entry": {
      "types": "./dist/entry.d.ts",
      "default": "./dist/entry.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --incremental false",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. freebuff-acp"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.17.1",
    "@codebuff/sdk": "^0.10.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
