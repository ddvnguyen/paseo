# Exclude non-app packages and docs from EAS upload.
# NOTE: protocol/plugin/highlight/expo-two-way-audio/relay must stay
# included — eas-build-post-install's build:app-deps step builds
# protocol/plugin/highlight/expo-two-way-audio from source, and client's
# build imports @getpaseo/relay/e2ee directly from packages/relay/src (its
# package.json "exports" map has no built dist fallback for that subpath).
# Excluding any of them breaks the build with "No workspaces found" or a
# "Cannot find module" TS error.
packages/cli/
packages/desktop/
packages/website/
docs/
.github/
.dev/
*.md
.gitignore
.easignore

# EAS cloud runner has bun 1.2 which can't read lockfileVersion 2 (bun 1.4+).
# Exclude bun.lock so EAS falls back to npm with package-lock.json.
bun.lock
bun.lockb
