# Paseo systemd --user unit: paseo.service (PROD daemon, :6767)
#
# Install:
#   cp deploy/systemd/paseo.service        ~/.config/systemd/user/
#   cp deploy/systemd/paseo-prestart.sh    ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now paseo.service
#
# Consolidation (2026-09): PASEO_HOME and the runtime tree now live together
# under $HOME/paseo/PROD. The runtime node_modules are installed by the
# "deploy-prod" pipeline stage (PROD_HOME=/home/ddv/paseo/PROD).
#
# ExecStart below was migrated off `daemon start --foreground --listen ...` on
# 2026-10-06, which superseded the older guard comment on this file. That
# comment said the runtime tree shipped a 0.6.x CLI with no `daemon run`, so
# rewriting the flags would break the unit and take every agent in the cgroup
# with it. That precondition no longer holds: ~/paseo/PROD installs
# 0.9.2-hub-7d30525687, which ships `daemon run`, verified in
# dist/commands/daemon/{index,start}.js. Re-check that before assuming it.
#
# `--listen` and `--no-web-ui` were removed from the daemon CLI and moved into
# daemon config; `daemon start --foreground` was replaced by `daemon run`. The
# old form only survived on a compat shim that hard-rejects it after 2027-02-01
# (packages/cli/src/commands/daemon/local-daemon.ts, COMPAT(daemon-start-flags)).
# Kept here, the unit starts today but crash-loops the moment that shim is
# dropped.
#
# The listen address and web-UI state now come from the environment below, not
# from flags: the daemon resolves cli > env.PASEO_LISTEN > config daemon.listen
# (packages/server/src/server/config.ts, resolveListenAddress). PASEO_LISTEN and
# PASEO_WEB_UI_ENABLED are stated explicitly so this unit does not inherit them
# from paseo-bun's defaults or from whatever a fresh PASEO_HOME's config.json
# happens to say — PROD's config.json does carry daemon.listen 0.0.0.0:6767, but
# a runtime tree with no config.json yet would fall back to loopback.
#
# NOTE: the live ~/.config/systemd/user/paseo.service still carries the legacy
# form. This repo file has no runtime effect until it is installed; migrating
# the live PROD unit is a separate operator action, because PROD owns every
# agent in its cgroup.
[Unit]
Description=Paseo coding-agent orchestrator daemon (hydra fork, PROD)
After=network-online.target

[Service]
Type=simple
# Hardening against the recurring EADDRINUSE crash-loop after unclean stops:
#   - ExecStartPre kills any stale process still holding port 6767 before the
#     new daemon starts (see paseo-prestart.sh).
#   - KillMode=mixed: on stop, SIGTERM to the main process only; the rest of
#     the cgroup (git worktree children, etc.) is SIGKILLed once the main
#     process exits, instead of every child getting an independent 90s grace.
#   - TimeoutStopSec=30: bound the stop; systemd stops waiting for D-state
#     git children instead of hanging for the 90s default then SIGKILLing.
Environment="PASEO_HOME=%h/paseo/PROD"
Environment="PASEO_PID_FILE=%h/paseo/PROD/paseo.pid"
Environment="PASEO_PRESTART_PORT=6767"
Environment="PASEO_LISTEN=0.0.0.0:6767"
# Detach-on-stop is deliberately NOT enabled here. It is an opt-in operator
# decision: it depends on adoption (which does not exist yet) to be useful, it
# only survives for the opencode HTTP server path, and with it on, any deploy
# would leave scoped children that nothing re-attaches or kills. To try it:
#   systemctl --user edit paseo.service
# and add Environment="PASEO_DETACH_AGENTS_ON_STOP=1" (see docs/development.md).
Environment="PASEO_APP_BASE_URL=https://paseo.ddvnguyen.com"
Environment="PASEO_WEB_UI_ENABLED=false"
Environment="PASEO_RELAY_ENABLED=true"
Environment="PASEO_RELAY_ENDPOINT=relay.paseo.sh:443"
Environment="PASEO_RELAY_USE_TLS=true"
Environment=PATH=%h/.bun/bin:%h/.nvm/versions/node/v24.15.0/bin:%h/.local/bin:%h/.opencode/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/paseo/PROD
ExecStartPre=%h/.config/systemd/user/paseo-prestart.sh
ExecStart=%h/paseo/PROD/paseo-bun daemon run --home %h/paseo/PROD
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=paseo

[Install]
WantedBy=default.target
