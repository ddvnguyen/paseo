# Paseo systemd --user unit: paseo-app.service
#
# Static file server for the Paseo PROD web UI via Caddy.
# The daemon (paseo.service) runs separately on port 6768 with --no-web-ui.
# Clients connect to the daemon via the "Add host" flow in the web UI.
#
# Install:
#   cp deploy/systemd/paseo-app.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now paseo-app.service

[Unit]
Description=Paseo — Static web UI server (Caddy)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/caddy run --config /home/ddv/paseo-prod/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /home/ddv/paseo-prod/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
