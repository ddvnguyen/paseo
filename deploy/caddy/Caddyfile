# Caddyfile — Paseo static web UI server
#
# Serves the standalone web UI build at http://localhost:6969.
# Daemons run separately (TEST on :6868, PROD on :6767).
# Clients connect to a daemon via the "Add host" flow — no reverse proxy needed.
#
# Each daemon's config.json must include this origin in cors.allowedOrigins:
#   "cors": { "allowedOrigins": ["http://localhost:6969"] }
# TODO(ddv): replace localhost:6969 with the real domain once paseo-app is
# deployed to a persistent host (e.g. "https://app.ddvnguyen.com").

:6969 {
	root * /home/ddv/paseo-app/web-ui
	file_server {
		precompressed br gzip
	}

	# SPA fallback: any path without a matching file serves index.html
	try_files {path} /index.html
	file_server /index.html

	# ── Cache headers ──────────────────────────────────────────────────────
	# Hashed assets (content-hashed filenames) → immutable
	@hashed path_regexp /[-.][0-9a-f]{16,}[-.]/
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# index.html → no-cache (always fresh)
	@root path /
	header @root Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate"

	# manifest.json → correct MIME type
	@manifest path /manifest.json
	header @manifest Content-Type "application/manifest+json"
}
