# Caddyfile — Paseo PROD static file server
#
# Serves the standalone web UI build at http://localhost:6767.
# The daemon runs separately (paseo.service on port 6768).
# Clients connect to the daemon via "Add host" — no reverse proxy needed.
#
# The daemon's config.json must include this origin in cors.allowedOrigins:
#   "cors": { "allowedOrigins": ["http://localhost:6767"] }

:6767 {
	root * /home/ddv/paseo-prod/web-ui
	file_server {
		precompressed br gzip
	}

	# SPA fallback: any path without a matching file serves index.html
	try_files {path} /index.html
	file_server /index.html

	# ── Cache headers ──────────────────────────────────────────────────────
	# Hashed assets (content-hashed filenames) → immutable
	@hashed path_regexp /[-.][0-9a-f]{16,}[-.]/
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# index.html → no-cache (always fresh)
	@root path /
	header @root Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate"

	# manifest.webmanifest → correct MIME type
	@manifest path /manifest.webmanifest
	header @manifest Content-Type "application/manifest+json"
}
