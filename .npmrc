link-workspace-packages=true
prefer-workspace-packages=true
# store-dir is intentionally unset: it must stay machine-local (see
# ~/.config/pnpm/config.yaml). Committing an absolute store path breaks every
# new worktree when the repo lives on a different filesystem than the store --
# pnpm cannot hardlink across devices and silently falls back to full copies.
public-hoist-pattern[]=*babel*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*metro*
